<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>network.noid.paranoid</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>ParanO(1)d</name>
  <summary>Private proof-native wallet</summary>
  <description>
    <p>
      ParanO(1)d is a native wallet for the NOID network. It supervises its
      bundled full node locally, so the wallet can be used without a terminal
      or a separately managed daemon.
    </p>
  </description>
  <launchable type="desktop-id">network.noid.paranoid.desktop</launchable>
  <icon type="stock">network.noid.paranoid</icon>
  <provides>
    <binary>paranoid-gui</binary>
  </provides>
  <categories>
    <category>Finance</category>
    <category>Network</category>
  </categories>
  <developer id="network.noid">
    <name>Paranoid Zero</name>
  </developer>
  <developer_name>Paranoid Zero</developer_name>
  <url type="homepage">https://noid.network/</url>
  <url type="bugtracker">https://github.com/ignotusnemo/paranoid/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@RELEASE_DATE@"/>
  </releases>
</component>
